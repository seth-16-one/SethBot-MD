{
  "name": "sethbot",
  "version": "1.0.0",
  "description": "WhatsApp Bot (SethBot-MD)",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "start:optimized": "node --max-old-space-size=512 --optimize-for-size --gc-interval=100 index.js",
    "install:panel": "npm install --legacy-peer-deps",
    "install:force": "npm install --force",
    "test": "node test/multi-customer-isolation.test.js && node test/load-integrity.test.js && node test/import-resolution.test.js && node test/startup.test.js && node test/session.test.js",
    "test:isolation": "node test/multi-customer-isolation.test.js",
    "test:load": "node test/load-integrity.test.js",
    "test:imports": "node test/import-resolution.test.js",
    "test:startup": "node test/startup.test.js",
    "docker:build": "docker build -t sethbot .",
    "test:session": "node test/session.test.js",
    "dev": "node --watch index.js"
  },
  "keywords": [
    "whatsapp-bot"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@adiwajshing/keyed-db": "^0.2.4",
